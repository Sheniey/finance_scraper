---
import { translations, type Locale, type Mnemonic } from '@/i18n'
import Section from '@/components/Section.astro'

interface Props {
	locale: Locale
}

type AudienceCard = {
	number: string
	title: Mnemonic
	body: Mnemonic
}

const { locale } = Astro.props as Props
const t = translations(locale)

const audienceCards: AudienceCard[] = [
	{
		number: 'A',
		title: 'audience.kids.title',
		body: 'audience.kids.description',
	},
	{
		number: 'B',
		title: 'audience.students.title',
		body: 'audience.students.description',
	},
	{
		number: 'C',
		title: 'audience.adults.title',
		body: 'audience.adults.description',
	},
	{
		number: 'D',
		title: 'audience.founders.title',
		body: 'audience.founders.description',
	},
]
---

<Section
	id='audience'
	ariaLabelledby='audience-title'
	class='bg-semiwhite dark:bg-background-dark'
>
		<div class='grid gap-8 md:grid-cols-[0.94fr_1.06fr] md:items-end md:gap-16'>
			<div>
				<h2
					id='audience-title'
					class='max-w-2xl font-heading text-4xl font-medium leading-[1.02] tracking-[-0.06em] sm:text-5xl md:text-6xl'
				>
					{t({ mnemonic: 'audience.title' })}
				</h2>
			</div>
			<p class='max-w-2xl text-base leading-7 text-muted-foreground sm:text-lg sm:leading-8'>
				{t({ mnemonic: 'audience.description' })}
			</p>
		</div>

		<div class='timeline-view animate-blurred-fade-in animate-range-[entry_10%_contain_30%] motion-reduce:animate-none mt-14 grid gap-3 sm:grid-cols-2 lg:grid-cols-4'>
			{
				audienceCards.map((card) => (
					<article class='rounded-2xl border border-border bg-card p-5 sm:p-6'>
						<p class='font-code text-[0.65rem] tracking-[0.18em] text-accent'>{card.number}</p>
						<h3 class='mt-8 font-heading text-xl font-medium tracking-[-0.04em] sm:text-2xl'>
							{t({ mnemonic: card.title })}
						</h3>
						<p class='mt-3 text-sm leading-6 text-muted-foreground'>
							{t({ mnemonic: card.body })}
						</p>
					</article>
				))
			}
		</div>

		<div class='mt-8 flex flex-col gap-5 rounded-2xl border border-accent/20 bg-accent/5.5 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-7'>
			<p class='max-w-3xl text-sm font-medium leading-6'>
				{t({ mnemonic: 'intro.callout' })}
			</p>
			<a
				href='#reports'
				class='inline-flex w-fit shrink-0 items-center gap-2 text-sm font-semibold text-accent outline-none transition-colors hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent'
			>
				{t({ mnemonic: 'audience.reports' })}
				<span aria-hidden='true'>↗</span>
			</a>
		</div>
</Section>
