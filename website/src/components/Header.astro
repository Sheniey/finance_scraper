---
import { APP_NAME, MEDIA } from "@/config";
import { translations, type Locale } from "@/i18n";
import { getNavigationItems, localizedRoute } from "@/lib/navigation";
import Download from "@/components/Download.astro";
import Language from "@/components/Language.astro";
import MobileNavigation from "@/components/MobileNavigation.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";

import MoreArrow from "@/assets/more-arrow.svg";

export interface Props {
	locale: Locale;
}

const { locale } = Astro.props as Props;
const t = translations(locale);
const navItems = getNavigationItems(locale);
const isHomePage =
	Astro.url.pathname.replace(/\/+$/, "") === localizedRoute(locale, "home");
---

<header
	id="site-header"
	data-site-header
	data-scrolled="false"
	class:list={[
		"fixed inset-x-0 top-0 z-200 border-b border-transparent backdrop-blur-xl transition-[background-color,border-color,box-shadow] duration-200 ease-out data-[scrolled=true]:border-border/50 data-[scrolled=true]:bg-background/82 data-[scrolled=true]:shadow-[0_1px_2px_rgba(10,10,10,0.04)] motion-reduce:transition-none",
		isHomePage ? "bg-black/10" : "bg-background/60",
	]}
>
	<nav
		data-nav-shell
		data-scrolled="false"
		class:list={[
			"mx-auto flex h-18 w-full max-w-7xl items-center justify-between gap-4 px-4 transition-colors duration-200 ease-out data-[scrolled=true]:text-foreground motion-reduce:transition-none sm:px-6 lg:px-8",
			isHomePage ? "text-white" : "text-foreground",
		]}
		aria-label={t({ mnemonic: "nav.primary_label" })}
	>
		<a
			class="group -ml-1 flex shrink-0 items-center gap-2.5 rounded-lg px-1 py-1 outline-none transition-[scale] duration-150 ease-out focus-visible:ring-2 focus-visible:ring-accent/60 active:scale-[0.97] motion-reduce:transition-none"
			href={localizedRoute(locale, "home")}
			aria-label={t({ mnemonic: "nav.home_label" })}
		>
			<span
				class="relative flex size-8 items-center justify-center overflow-hidden rounded-[8px] bg-[#111820]"
			>
				<img
					src={MEDIA.logo.minimal}
					alt=""
					width="32"
					height="32"
					loading="eager"
					class="h-full w-full object-contain"
				/>
			</span>
			<span
				class="hidden text-base font-semibold tracking-[-0.02em] text-current sm:inline"
			>
				{APP_NAME.styled}
			</span>
		</a>

		<div class="ml-auto flex shrink-0 items-center gap-1 md:gap-2">
			<ul class="hidden items-center gap-1 md:flex">
				{
					navItems.map((item) =>
						"children" in item ? (
							<li>
								<details
									class="group relative shrink-0"
									data-navigation-dropdown
								>
									<summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-full px-3.5 py-2.5 text-[0.9rem] font-medium text-current/70 outline-none transition-[background-color,color] duration-150 ease-out hover:bg-current/5 hover:text-current focus-visible:ring-2 focus-visible:ring-accent/60 motion-reduce:transition-none [&::-webkit-details-marker]:hidden">
										{item.label}
										<MoreArrow class="size-3 transition-transform duration-200 group-open:rotate-180 motion-reduce:transition-none" />
									</summary>
									<div class="absolute left-0 top-[calc(100%+0.75rem)] z-50 grid min-w-64 gap-1 rounded-2xl border border-white/10 bg-[#07101f]/96 p-2 text-white shadow-2xl backdrop-blur-2xl">
										{item.children.map((child) => (
											<a
												href={child.href}
												class="rounded-xl px-3 py-2.5 text-sm text-white/75 outline-none transition-colors hover:bg-white/8 hover:text-white focus-visible:ring-2 focus-visible:ring-accent/70 motion-reduce:transition-none"
											>
												{child.label}
											</a>
										))}
									</div>
								</details>
							</li>
						) : (
							<li>
								<a
									href={item.href}
									class="rounded-full px-3.5 py-2.5 text-[0.9rem] font-medium text-current/70 outline-none transition-[background-color,color] duration-150 ease-out hover:bg-current/5 hover:text-current focus-visible:ring-2 focus-visible:ring-accent/60 motion-reduce:transition-none"
								>
									{item.label}
								</a>
							</li>
						),
					)
				}
			</ul>

			<div class="site-header-actions flex shrink-0 items-center gap-0.5">
				<Download
					label={t({ mnemonic: "download.button" })}
					ariaLabel={t({ mnemonic: "download.button_aria" })}
					detectingLabel={t({ mnemonic: "download.detecting" })}
					readyLabel={t({ mnemonic: "download.ready" })}
					unsupportedPlatformLabel={t({
						mnemonic: "download.unsupported_platform",
					})}
					unsupportedArchitectureLabel={t({
						mnemonic: "download.unsupported_architecture",
					})}
					unknownPlatformLabel={t({
						mnemonic: "download.unknown_platform",
					})}
					class="order-first md:order-0"
				/>
				<span
					aria-hidden="true"
					class="px-1 text-[0.85rem] leading-none text-current/40"
				>
					|
				</span>
				<Language locale={locale} />
				<ThemeToggle locale={locale} />
			</div>

			<MobileNavigation items={navItems} locale={locale} />
		</div>
	</nav>
</header>

<script>
	const $ = (selector: string) => document.querySelector(selector);
	const $header = $("[data-site-header]") as HTMLElement | null;
	const $nav = $("[data-nav-shell]") as HTMLElement | null;
	const $hero = $("#hero") as HTMLElement | null;
	const $backToTop = $("[data-back-to-top]") as HTMLAnchorElement | null;

	if (!$header || !$nav) {
		throw new Error("Site header elements are required for scroll styling");
	}

	const updateHeaderState = () => {
		const hasPassedHero =
			$hero !== null &&
			$hero.getBoundingClientRect().bottom <= $header.offsetHeight;
		const isScrolled = String($hero ? hasPassedHero : window.scrollY > 16);
		$header.dataset.scrolled = isScrolled;
		$nav.dataset.scrolled = isScrolled;

		if ($backToTop) {
			$backToTop.dataset.visible = String(hasPassedHero);
			$backToTop.setAttribute("aria-hidden", String(!hasPassedHero));
			$backToTop.tabIndex = hasPassedHero ? 0 : -1;
		}
	};

	updateHeaderState();
	window.addEventListener("scroll", updateHeaderState, { passive: true });
	window.addEventListener("resize", updateHeaderState);
</script>
