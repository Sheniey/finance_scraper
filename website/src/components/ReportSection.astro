---
import { translations, type Locale, type Mnemonic } from '@/i18n'
import Section from '@/components/Section.astro'

interface Props {
	locale: Locale
}

const { locale } = Astro.props as Props
const t = translations(locale)

const reportPoints: Mnemonic[] = [
	'report.point1',
	'report.point2',
	'report.point3',
	'report.point4',
	'report.point5',
]
---

<Section
	id='reports'
	ariaLabelledby='report-title'
	class='overflow-hidden bg-primary text-primary-foreground'
	containerClass='grid gap-14 lg:grid-cols-[0.88fr_1.12fr] lg:items-center lg:gap-20'
>
	<div>
			<h2
				id='report-title'
				class='max-w-xl font-heading text-4xl font-medium leading-[1.02] tracking-[-0.06em] sm:text-5xl md:text-6xl'
			>
				{t({ mnemonic: 'report.title' })}
			</h2>
			<p class='mt-6 max-w-xl text-base leading-7 text-white/68 sm:text-lg sm:leading-8'>
				{t({ mnemonic: 'report.description' })}
			</p>

			<ul class='mt-8 grid gap-x-6 gap-y-3 sm:grid-cols-2'>
				{
					reportPoints.map((mnemonic) => (
						<li class='flex items-center gap-3 text-sm text-white/80'>
							<span class='grid size-5 shrink-0 place-items-center rounded-full border border-[#ffab76]/45 text-[0.6rem] text-[#ffab76]'>
								✓
							</span>
							{t({ mnemonic })}
						</li>
					))
				}
			</ul>

			<p class='mt-8 max-w-lg border-l border-[#ffab76]/55 pl-4 text-xs leading-5 text-white/48'>
				{t({ mnemonic: 'report.small_note' })}
			</p>
		</div>

		<figure
			role='img'
			aria-label={t({ mnemonic: 'report.placeholder' })}
			class='timeline-view animate-blurred-fade-in animate-range-[entry_10%_contain_30%] motion-reduce:animate-none relative overflow-hidden rounded-[1.5rem] border border-white/[0.14] bg-[#07101b] p-3 shadow-[0_32px_90px_rgba(0,0,0,0.28)] sm:rounded-[2rem] sm:p-5'
		>
			<div aria-hidden='true' class='rounded-[1.2rem] border border-white/8 bg-white/[0.035] p-4 sm:p-6'>
				<div class='flex items-center justify-between gap-4 border-b border-white/8 pb-5'>
					<div class='flex items-center gap-3'>
						<div class='grid size-10 place-items-center rounded-xl bg-accent/15 font-code text-xs text-[#ffab76]'>
							FS
						</div>
						<div class='grid gap-2'>
							<div class='h-2.5 w-32 rounded-full bg-white/20'></div>
							<div class='h-2 w-20 rounded-full bg-white/10'></div>
						</div>
					</div>
					<span class='rounded-full border border-white/10 px-3 py-1 font-code text-[0.55rem] uppercase tracking-[0.14em] text-white/40'>
						{t({ mnemonic: 'report.card_label' })}
					</span>
				</div>

				<div class='mt-5 grid grid-cols-3 gap-2.5'>
					<div class='rounded-xl border border-white/[0.07] bg-white/[0.035] p-3'>
						<div class='h-1.5 w-12 rounded-full bg-white/10'></div>
						<div class='mt-3 h-4 w-16 rounded-full bg-white/20'></div>
						<div class='mt-2 h-1.5 w-10 rounded-full bg-accent/30'></div>
					</div>
					<div class='rounded-xl border border-white/[0.07] bg-white/[0.035] p-3'>
						<div class='h-1.5 w-12 rounded-full bg-white/10'></div>
						<div class='mt-3 h-4 w-14 rounded-full bg-white/20'></div>
						<div class='mt-2 h-1.5 w-8 rounded-full bg-emerald-300/25'></div>
					</div>
					<div class='rounded-xl border border-white/[0.07] bg-white/[0.035] p-3'>
						<div class='h-1.5 w-12 rounded-full bg-white/10'></div>
						<div class='mt-3 h-4 w-12 rounded-full bg-white/20'></div>
						<div class='mt-2 h-1.5 w-9 rounded-full bg-white/10'></div>
					</div>
				</div>

				<div class='mt-4 grid gap-3 sm:grid-cols-[1.25fr_0.75fr]'>
					<div class='relative min-h-40 overflow-hidden rounded-xl border border-white/[0.07] bg-white/2.5 p-4'>
						<div class='h-2 w-28 rounded-full bg-white/15'></div>
						<svg
							aria-hidden='true'
							class='absolute inset-x-4 bottom-4 h-24 w-[calc(100%-2rem)]'
							viewBox='0 0 320 100'
							preserveAspectRatio='none'
						>
							<path
								d='M0 80C36 73 40 57 72 61s39 24 66 12 35-47 65-38 42 33 62 10 36-28 55-34'
								fill='none'
								stroke='rgba(255,109,0,0.42)'
								stroke-width='2'
							/>
							<path
								d='M0 87H320M0 55H320M0 23H320'
								fill='none'
								stroke='rgba(255,255,255,0.07)'
								stroke-width='1'
							/>
						</svg>
					</div>
					<div class='grid gap-3'>
						<div class='rounded-xl border border-white/[0.07] bg-white/2.5 p-4'>
							<div class='h-2 w-20 rounded-full bg-white/10'></div>
							<div class='mt-4 flex h-10 items-end gap-1.5'>
								<div class='h-5 flex-1 rounded-t bg-white/10'></div>
								<div class='h-8 flex-1 rounded-t bg-white/15'></div>
								<div class='h-6 flex-1 rounded-t bg-accent/25'></div>
								<div class='h-10 flex-1 rounded-t bg-white/20'></div>
								<div class='h-7 flex-1 rounded-t bg-white/10'></div>
							</div>
						</div>
						<div class='rounded-xl border border-white/[0.07] bg-white/2.5 p-4'>
							<div class='h-2 w-16 rounded-full bg-white/10'></div>
							<div class='mt-3 h-2 w-full rounded-full bg-white/8'></div>
							<div class='mt-2 h-2 w-4/5 rounded-full bg-white/8'></div>
						</div>
					</div>
				</div>
			</div>
			<figcaption class='flex flex-col gap-2 px-2 pb-1 pt-4 text-xs leading-5 text-white/45 sm:flex-row sm:items-center sm:justify-between sm:px-3'>
				<span>{t({ mnemonic: 'report.card_title' })}</span>
				<span>{t({ mnemonic: 'report.caption' })}</span>
			</figcaption>
		</figure>
</Section>
