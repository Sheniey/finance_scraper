---
import { translations, type Locale, type Mnemonic } from "@/i18n";
import Section from "@/components/Section.astro";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props as Props;
const t = translations(locale);

const heroPhrases: Mnemonic[] = [
	"hero.dynamic_phrase1",
	"hero.dynamic_phrase2",
	"hero.dynamic_phrase3",
];
---

<Section
	id="hero"
	ariaLabelledby="hero-title"
	fullBleed={true}
	class="isolate flex min-h-[min(850px,100svh)] items-end overflow-hidden bg-[#07101b] text-white"
>
	<video
		class="absolute inset-0 -z-20 h-full w-full object-cover object-[56%_center] opacity-55 motion-reduce:hidden"
		src="/videos/finance_scraper_hero_vid.mp4"
		muted
		loop
		playsinline
		preload="metadata"
		aria-hidden="true"
		data-hero-video
	></video>
	<div
		aria-hidden="true"
		class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(4,10,16,0.94)_0%,rgba(4,10,16,0.74)_42%,rgba(4,10,16,0.16)_100%)]"
	>
	</div>
	<div
		aria-hidden="true"
		class="absolute inset-0 -z-10 bg-[linear-gradient(0deg,rgba(4,10,16,0.84)_0%,transparent_48%,rgba(4,10,16,0.16)_100%)]"
	>
	</div>
	<div
		aria-hidden="true"
		class="pointer-events-none absolute -left-32 top-1/4 -z-10 size-112 rounded-full bg-[#ff6d00]/10 blur-[110px]"
	>
	</div>

	<div
		class="mx-auto grid w-full max-w-310 grid-cols-1 px-5 pb-20 pt-36 sm:px-8 md:pb-24 md:pt-44"
	>
		<div class="max-w-4xl">
			<h1
				id="hero-title"
				class="max-w-5xl font-heading text-[clamp(3.25rem,9vw,7.8rem)] font-medium leading-[0.91] tracking-[-0.075em]"
			>
				<span class="block"
					><strong>{t({ mnemonic: "hero.static_phrase" })}</strong
					></span
				>
				<span
					aria-hidden="true"
					class="relative mt-2 grid min-h-[1.08em] max-w-[12ch]"
				>
					{
						heroPhrases.map((mnemonic) => (
							<span class="hero-phrase col-start-1 row-start-1 max-w-full text-[#ffd0ad]">
								{t({ mnemonic })}
							</span>
						))
					}
				</span>
				<span class="sr-only"
					>{t({ mnemonic: "hero.accessible_phrases" })}</span
				>
			</h1>
			<p
				class="mt-7 max-w-2xl text-base leading-7 text-white/75 sm:text-lg sm:leading-8 md:mt-9"
			>
				{t({ mnemonic: "hero.summary" })}
			</p>
			<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
				<a
					href="#overview"
					class="group inline-flex min-h-12 items-center justify-center gap-3 rounded-full bg-white px-6 py-3 text-sm font-semibold text-[#111820] outline-none transition-[background-color,transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:bg-[#ffede0] hover:shadow-[0_12px_32px_rgba(255,109,0,0.15)] focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-4 focus-visible:ring-offset-[#07101b] motion-reduce:transition-none"
				>
					{t({ mnemonic: "hero.primary_button" })}
					<span
						aria-hidden="true"
						class="transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transition-none"
					>
						↗
					</span>
				</a>
				<a
					href="#market-network"
					class="inline-flex min-h-12 items-center justify-center gap-3 rounded-full border border-white/35 bg-white/4 px-6 py-3 text-sm font-semibold text-white outline-none backdrop-blur-md transition-[background-color,border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-white/70 hover:bg-white/10 focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-4 focus-visible:ring-offset-[#07101b] motion-reduce:transition-none"
				>
					{t({ mnemonic: "hero.secondary_button" })}
					<span aria-hidden="true">↓</span>
				</a>
			</div>
		</div>
	</div>

	<a
		href="#overview"
		aria-label={t({ mnemonic: "intro.title" })}
		class="absolute bottom-7 right-6 hidden size-12 items-center justify-center rounded-full border border-white/25 text-white/80 outline-none transition-[background-color,transform] hover:-translate-y-1 hover:bg-white/10 focus-visible:ring-2 focus-visible:ring-white sm:flex md:bottom-10 md:right-10"
	>
		<span aria-hidden="true">↓</span>
	</a>
	<div
		class="pointer-events-none absolute bottom-0 left-0 h-px w-full bg-linear-to-r from-transparent via-white/20 to-transparent"
	>
	</div>
</Section>

<script>
	const HERO_VIDEO_PLAY_WARNING = "Unable to play the hero background video";
	const $ = (selector: string) => document.querySelector(selector);
	const $heroVideo = $("[data-hero-video]") as HTMLVideoElement | null;

	if ($heroVideo) {
		const motionPreference = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		);
		const updateHeroMotion = () => {
			if (motionPreference.matches) {
				$heroVideo.pause();
				return;
			}

			$heroVideo.play().catch((error: unknown) => {
				console.warn(HERO_VIDEO_PLAY_WARNING, error);
			});
		};

		updateHeroMotion();
		motionPreference.addEventListener("change", updateHeroMotion);
	}
</script>

<style>
	.hero-phrase {
		animation: hero-phrase-cycle 12s ease-in-out infinite;
	}

	.hero-phrase:nth-child(2) {
		animation-delay: -4s;
	}

	.hero-phrase:nth-child(3) {
		animation-delay: -8s;
	}

	@keyframes hero-phrase-cycle {
		0%,
		3% {
			opacity: 0;
		}

		6%,
		25% {
			opacity: 1;
		}

		34%,
		100% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-phrase {
			animation: none;
		}

		.hero-phrase:not(:first-child) {
			opacity: 0;
		}

		.hero-phrase:first-child {
			opacity: 1;
		}
	}
</style>
