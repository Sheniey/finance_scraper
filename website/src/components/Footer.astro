---
import { APP_NAME, MEDIA, SITE } from '@/config';
import { translations, type Locale } from '@/i18n';
import { getNavigationItems, localizedRoute } from '@/lib/navigation';

import Instagram from '@/assets/instagram.svg';
import LinkedIn from '@/assets/linkedin.svg';
import X from '@/assets/x.svg';
import YouTube from '@/assets/youtube.svg';
import Spotify from '@/assets/spotify.svg';
import type { SvgComponent } from 'astro/types';


export interface Props {
	locale: Locale;
}

const { locale } = Astro.props as Props;
const t = translations(locale);
const navigationItems = getNavigationItems(locale);
const exploreItems = navigationItems.flatMap((item) =>
	'children' in item ? item.children : [item]
);
const socialLinks: { label: string; href: string; icon: SvgComponent & ImageMetadata }[] = [
	{ label: 'Instagram', href: SITE.authorIg, icon: Instagram },
	{ label: 'LinkedIn', href: SITE.authorLinkedIn, icon: LinkedIn },
	{ label: 'X', href: SITE.authorX, icon: X },
	{ label: 'YouTube', href: SITE.authorYoutube, icon: YouTube },
	{ label: 'Spotify', href: SITE.authorSpotify, icon: Spotify },
];

const legalItems = [
	{ label: t({ mnemonic: 'footer.privacy' }), href: `/${locale}/legal/privacy` },
	{ label: t({ mnemonic: 'footer.terms' }), href: `/${locale}/legal/terms` },
	{ label: t({ mnemonic: 'footer.financial' }), href: `/${locale}/legal/financial-disclaimer` },
];
---

<footer class="relative isolate overflow-hidden bg-[#05080c] text-white">
	<div
		aria-hidden="true"
		class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_12%_0%,rgba(255,109,0,0.14),transparent_28%),radial-gradient(circle_at_92%_18%,rgba(49,94,153,0.19),transparent_30%)]"
	>
	</div>
	<div
		aria-hidden="true"
		class="pointer-events-none absolute -right-24 top-24 -z-10 size-72 rounded-full bg-accent/8 blur-3xl"
	>
	</div>

	<div class="mx-auto max-w-310 px-5 pb-7 pt-14 sm:px-8 md:pt-20">
		<div
			class="mb-12 flex flex-col gap-8 md:mb-14 md:flex-row md:items-end md:justify-between"
		>
			<div class="max-w-2xl">
				<h2
					class="max-w-2xl font-heading text-3xl font-medium tracking-[-0.055em] text-white sm:text-4xl md:text-5xl"
				>
					{t({ mnemonic: "cta.title" })}
				</h2>
			</div>
			<a
				href={SITE.repo}
				rel="noreferrer"
				class="group inline-flex w-fit shrink-0 items-center gap-3 rounded-full bg-white px-5 py-3 text-sm font-semibold text-[#10151a] outline-none transition-[background-color,transform] duration-200 hover:-translate-y-0.5 hover:bg-[#ffede0] focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-4 focus-visible:ring-offset-[#05080c] motion-reduce:transition-none"
			>
				{t({ mnemonic: "cta.button" })}
				<span
					aria-hidden="true"
					class="transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transition-none"
				>
					↗
				</span>
			</a>
		</div>

		<div class="border-y border-white/11">
			<!-- Footer Sections -->
			<div
				class="grid gap-10 py-10 sm:grid-cols-2 lg:grid-cols-[1.2fr_0.7fr_0.9fr_0.95fr] lg:gap-12"
			>
				<div class="max-w-sm">
					<a
						href={localizedRoute(locale, "home")}
						aria-label={t({ mnemonic: "nav.home_label" })}
						class="inline-flex rounded-md outline-none focus-visible:ring-2 focus-visible:ring-accent"
					>
						<img
							src={MEDIA.logo.banner}
							alt={APP_NAME.fullname}
							width="1277"
							height="473"
							loading="lazy"
							class="w-full max-w-52 object-contain object-left"
						/>
					</a>
					<p class="mt-5 text-sm leading-6 text-white/55">
						{t({ mnemonic: "footer.summary" })}
					</p>
				</div>

				<!-- Explore Section -->
				<div>
					<p
						class="mb-5 font-code text-[0.70rem] font-semibold uppercase select-none tracking-[0.25em] text-white/40"
					>
						{t({ mnemonic: "footer.explore" })}
					</p>
					<nav
						class="grid justify-start gap-3"
						aria-label={t({ mnemonic: "nav.primary_label" })}
					>
						{
							exploreItems.map((item) => (
								<a
									href={item.href}
									class="group inline-flex w-fit items-center gap-2 text-sm text-white/65 outline-none transition-colors duration-200 hover:text-white focus-visible:ring-2 focus-visible:ring-accent/70 motion-reduce:transition-none"
								>
									<span>{item.label}</span>
									<span
										aria-hidden="true"
										class="opacity-0 transition-[opacity,transform] duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:opacity-100 motion-reduce:transition-none"
									>
										↗
									</span>
								</a>
							))
						}
					</nav>
				</div>

				<!-- Legal Section -->
				<div>
					<p
						class="mb-5 font-code text-[0.70rem] font-semibold uppercase select-none tracking-[0.25em] text-white/40"
					>
						{t({ mnemonic: "footer.legal" })}
					</p>
					<nav
						class="grid justify-start gap-3"
						aria-label={t({ mnemonic: "footer.legal" })}
					>
						{
							legalItems.map((item) => (
								<a
									href={item.href}
									class="w-fit text-sm text-white/65 outline-none transition-colors duration-200 hover:text-white focus-visible:ring-2 focus-visible:ring-accent/70 motion-reduce:transition-none"
								>
									{item.label}
								</a>
							))
						}
					</nav>
				</div>

				<!-- Repository Section -->
				<div>
					<p
						class="mb-5 font-code text-[0.70rem] font-semibold uppercase select-none tracking-[0.25em] text-white/40"
					>
						{t({ mnemonic: "footer.repo" })}
					</p>
					<div class="grid justify-start gap-3">
						<a
							href={SITE.repo}
							rel="noreferrer"
							class="w-fit text-sm text-white/65 outline-none transition-colors duration-200 hover:text-white focus-visible:ring-2 focus-visible:ring-accent/70 motion-reduce:transition-none"
						>
							{t({ mnemonic: "footer.github" })}
						</a>
						<a
							href={SITE.repo + "/issues"}
							rel="noreferrer"
							class="w-fit text-sm text-white/65 outline-none transition-colors duration-200 hover:text-white focus-visible:ring-2 focus-visible:ring-accent/70 motion-reduce:transition-none"
						>
							{t({ mnemonic: "footer.issues" })}
						</a>
					</div>
					<p class="mt-6 max-w-xs text-xs leading-5 text-white/40">
						{t({ mnemonic: "disclaimer" })}
					</p>
				</div>
			</div>

			<div
				class="flex flex-col gap-5 border-t border-white/9 py-6 text-xs text-white/40 sm:flex-row sm:items-center sm:justify-between"
			>
				<p>
					© {new Date().getFullYear()}
					{' ' + APP_NAME.fullname}. {t({ mnemonic: "footer.rights" })}
				</p>
				<div class="flex flex-wrap items-center gap-3">
					<p class="font-medium text-white/75">
						{t({ mnemonic: "footer.follow_us" })}
					</p>
					<nav
						aria-label={t({ mnemonic: "footer.social_links_label" })}
						class="flex items-center gap-2"
					>
						{
							socialLinks.map((social) => (
								<a
									href={social.href}
									aria-label={social.label}
									title={social.label}
									target="_blank"
									rel="me noopener noreferrer"
									class="group grid size-9 place-items-center rounded-full text-white outline-none transition-[transform,border-color,background-color] duration-200 hover:border-accent/60 hover:bg-white/8 focus-visible:ring-2 focus-visible:ring-accent/70 motion-reduce:transition-none"
								>
									<social.icon />
								</a>
							))
						}
					</nav>
				</div>
			</div>
		</div>
	</div>
</footer>
