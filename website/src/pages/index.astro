---
import { DEFAULT_LOCALE, LOCALES } from '@/config'

const defaultHomeHref = `/${DEFAULT_LOCALE}/home`
---

<!doctype html>
<html lang={DEFAULT_LOCALE}>
	<head>
		<meta charset='utf-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1' />
		<meta name='robots' content='noindex' />
		<noscript>
			<meta http-equiv='refresh' content={`0;url=${defaultHomeHref}`} />
		</noscript>
		<script
			is:inline
			define:vars={{ supportedLocales: LOCALES, defaultLocale: DEFAULT_LOCALE }}
		>
			const browserLanguages =
				navigator.languages?.length > 0 ? navigator.languages : [navigator.language]
			const selectedLocale =
				browserLanguages
					.map((language) => language.toLowerCase().split('-')[0])
					.find((language) => supportedLocales.includes(language)) ?? defaultLocale

			window.location.replace(`/${selectedLocale}/home`)
		</script>
	</head>
	<body>
		<p><a href={defaultHomeHref}>Finance Scraper</a></p>
	</body>
	</html>
