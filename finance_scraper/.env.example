
# APP
# Public OAuth client ID configured by the application publisher, not end users.
GOOGLE_OAUTH_CLIENT_ID=

# LLM provider credentials. Models and provider priority live in src/settings.yaml.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# API
# Turso Sync database URL (turso:// or https://), never include credentials here.
DB_LOCATION=turso://financescraper-sheniey.aws-us-west-2.turso.io
# Create a database-scoped DML-only token; keep the value only in .env/secrets.
DB_AUTH_TOKEN=
DB_LOCAL_PATH=src/finance/db/sync/financescraper.sqlite3
DB_POOL_SIZE=2
DB_POOL_TIMEOUT=5
# Optional query counters/timing for local profiling.
DB_PROFILE=false
JWT_SECRET_KEY=kjsahndhjkasbdbajhdagb
